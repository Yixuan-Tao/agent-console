{
  "name": "@local/dsh-agent-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent 控制台：在本机统一查看并驱动 Codex / Grok Bot / Marvis / WorkBuddy 的会话。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "collector.py",
    "send_ui.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
